# Grumo Framework — Environment Variables
#
# All variables are optional for local development. A fresh application uses
# Grumo Store at .grumo/application.grumo and requires no external database,
# queue, event server or object server.
#
# Precedence: project config > GRUMO_* environment variables > Runtime defaults

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# GRUMO_ENV=production
# GRUMO_DEBUG=false
# GRUMO_HOST=0.0.0.0
# GRUMO_PORT=8000

# ---------------------------------------------------------------------------
# Grumo Store — default durable application infrastructure
# ---------------------------------------------------------------------------

# Default provider is "grumo".
# GRUMO_STORE_PROVIDER=grumo

# Default path:
# GRUMO_STORE_PATH=.grumo/application.grumo

# Keep Store enabled for the Store-first default Runtime. Disabling it while
# default Store-backed domains are selected fails explicitly; it does not fall
# back to SQLite.
# GRUMO_STORE_ENABLED=true

# Durability mode supported by the Store binding/configuration.
# GRUMO_STORE_DURABILITY=data
# GRUMO_STORE_REPAIR_TORN_TAIL=true

# IMPORTANT: one Runtime process owns one live local Store writer. Do not point
# multiple uvicorn/gunicorn workers or Grumo Nodes at the same .vstore file.

# ---------------------------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------------------------

# MUST be replaced in production.
# GRUMO_SECRET_KEY=change-me-in-production
# GRUMO_TOKEN_EXPIRY=604800
# Optional JWT validation contract. Previous secrets are comma-separated and
# should be removed after the rotation window closes.
# GRUMO_JWT_ISSUER=your-service-name
# GRUMO_JWT_AUDIENCE=your-client
# GRUMO_JWT_CLOCK_SKEW=30
# GRUMO_JWT_PREVIOUS_SECRETS=old-secret-1,old-secret-2
# GRUMO_JWT_REVOCATION_MAX=10000

# ---------------------------------------------------------------------------
# Database domain
# ---------------------------------------------------------------------------

# Fresh-app default:
# GRUMO_DATABASE_PROVIDER=grumo

# Explicit PostgreSQL override:
# GRUMO_DATABASE_PROVIDER=postgres
# GRUMO_DATABASE_URL=postgresql://user:pass@localhost:5432/grumo

# Explicit SQLite compatibility override:
# GRUMO_DATABASE_PROVIDER=sqlite
# GRUMO_DB_PATH=.grumo/state/data.db

# DATABASE_URL is also recognized for explicit supported SQL URLs.
# DATABASE_URL=postgresql://user:pass@localhost:5432/grumo

# ---------------------------------------------------------------------------
# Durable Queue / Jobs
# ---------------------------------------------------------------------------

# Fresh-app default:
# GRUMO_QUEUE_PROVIDER=grumo

# Explicit Redis override:
# GRUMO_QUEUE_PROVIDER=redis
# GRUMO_QUEUE_URL=redis://localhost:6379/0

# Other registered explicit queue adapters may have their own requirements.
# GRUMO_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Events
# ---------------------------------------------------------------------------

# Fresh-app default:
# GRUMO_EVENTS_PROVIDER=grumo

# Explicit provider examples:
# GRUMO_EVENTS_PROVIDER=postgres
# GRUMO_EVENTS_URL=postgresql://user:pass@localhost:5432/grumo

# Legacy/provider-specific file paths apply only when that provider is selected.
# GRUMO_EVENTS_PATH=.grumo/state/events.db

# ---------------------------------------------------------------------------
# Objects
# ---------------------------------------------------------------------------

# Fresh-app default:
# GRUMO_OBJECTS_PROVIDER=grumo

# Explicit S3-compatible override:
# GRUMO_OBJECTS_PROVIDER=s3
# GRUMO_BUCKET=my-bucket
# GRUMO_OBJECTS_ENDPOINT=https://object.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Explicit local/filesystem adapter settings apply only when selected.
# GRUMO_OBJECTS_DIR=.grumo/objects

# ---------------------------------------------------------------------------
# Cache — transient by default
# ---------------------------------------------------------------------------

# Cache is intentionally memory-backed unless explicitly overridden.
# GRUMO_CACHE_PROVIDER=memory
# GRUMO_CACHE_PROVIDER=redis
# GRUMO_CACHE_URL=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Edge
# ---------------------------------------------------------------------------

# Edge durable device/session/effect/replay state uses the same Runtime Store by
# default when Edge is enabled.
# GRUMO_EDGE_ENABLED=true
# GRUMO_EDGE_MQTT_ENABLED=false

# ---------------------------------------------------------------------------
# AI models — optional
# ---------------------------------------------------------------------------

# GRUMO_MODELS_DEFAULT=mock:default
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# User uploads/static files
# ---------------------------------------------------------------------------

# This is application file content, separate from Runtime durable infrastructure.
# GRUMO_STORAGE_DIR=storage

# ---------------------------------------------------------------------------
# TEST INFRASTRUCTURE — optional contract-test services
# ---------------------------------------------------------------------------

# PostgreSQL contracts
# GRUMO_TEST_DATABASE_URL=postgresql://grumo:grumo@localhost:5432/grumo_test

# S3-compatible contracts
# GRUMO_TEST_S3_ENDPOINT=http://localhost:9000
# GRUMO_TEST_S3_BUCKET=grumo-test
# GRUMO_TEST_S3_KEY=minioadmin
# GRUMO_TEST_S3_SECRET=minioadmin

# Redis contracts
# GRUMO_TEST_REDIS_URL=redis://localhost:6379/0
